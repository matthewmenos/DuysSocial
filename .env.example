# ─── DUYS Node Environment ───
SECRET_KEY=change-me-to-a-long-random-string
NODE_ENV=development
APP_NAME=DUYS
APP_URL=http://localhost:5173
API_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Local dev + tests use SQLite (zero deps): the prisma schema ships with
# provider = "sqlite", so no server is needed. Start with `npm run db:push`.
# Production/PostgreSQL: set this to a postgresql:// URL and build with
#   npm run db:push:pg   (derives a postgresql copy of the schema)
DATABASE_URL=file:./dev.db

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=duys-media
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=duys-private

POINTS_AD_REWARD=10
POINTS_REFERRAL_BONUS=100
REFERRAL_EARN_PERCENT=0.01

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@duys.app

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56
DUYS_CONTRACT_ADDRESS=
VAULT_WALLET_ADDRESS=
VAULT_PRIVATE_KEY=
CLAIM_POINTS_PER_TOKEN=10
CLAIM_MIN_POINTS=100
CLAIM_MAX_DAILY=1
CLAIM_MAX_DAILY_VERIFIED=3

USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
USDT_DECIMALS=18
SWAP_SPREAD_PERCENT=2.0
SWAP_MIN_USDT=1.0

HYPELAB_PLACEMENT_SLUG=
HYPELAB_SIGNING_SECRET=
WALLETCONNECT_PROJECT_ID=

# Swap mid-rate source (DUYS per USDT). If empty, falls back to SWAP_MID_RATE_FALLBACK.
# MID_RATE_URL=https://api.dexscreener.com/latest/dex/pairs/bsc/0x... ; MID_RATE_API_KEY=
SWAP_MID_RATE_FALLBACK=1

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

FACE_WORKER_URL=http://localhost:5100
POST_CHAR_LIMIT=500
POST_CHAR_LIMIT_VERIFIED=1000
