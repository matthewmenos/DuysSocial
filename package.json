{
  "name": "duys",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "db:generate": "npm run prisma:generate -w server",
    "db:push": "npm run prisma:push -w server",
    "db:generate:pg": "npm run db:generate:pg -w server",
    "db:push:pg": "npm run db:push:pg -w server",
    "build": "npm run build -w server && npm run build -w client",
    "build:prod": "npm run build:prod -w server",
    "test": "npm test -w server",
    "start": "npm start -w server"
  }
}
