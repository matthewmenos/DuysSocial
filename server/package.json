{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && prisma db push && tsc -p tsconfig.json && npm run build -w client",
    "build:prod": "npm run db:generate:pg && npm run db:push:pg && tsc -p tsconfig.json && npm run build -w client",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "test": "node test/run.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:generate:pg": "node scripts/make-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:pg": "node scripts/make-postgres-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "viem": "^2.56.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
